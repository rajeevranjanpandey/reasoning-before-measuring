<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram name="Architecture" id="Architecture">
    <mxGraphModel dx="1200" dy="900" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1080" pageHeight="760" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="A" value="&lt;b&gt;A   Offline preparation and pinned artefacts&lt;/b&gt;&lt;br&gt;&lt;br&gt;Training labels fit predictor and rankings; validation selects settings&lt;br&gt;Training-only donors · pinned model weights · separate held-out partitions" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#465469;strokeWidth=1.3;fillColor=#F6F7F9;fontColor=#111111;fontFamily=Times New Roman;fontSize=18;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1020" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="B" value="&lt;b&gt;B   Acquisition policies and declared information access&lt;/b&gt;&lt;br&gt;&lt;br&gt;Raw SLM: observed values + probabilities + descriptions; assisted SLM: also rounded scores&lt;br&gt;Static orders and fixed plans are reused; entropy tool selects from its own scores" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#465469;strokeWidth=1.3;fillColor=#F6F7F9;fontColor=#111111;fontFamily=Times New Roman;fontSize=18;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="180" width="1020" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="C" value="&lt;b&gt;C   Episode runtime and shared predictor&lt;/b&gt;&lt;br&gt;&lt;br&gt;Validate remaining-ID requests; one repair; fallback&lt;br&gt;Update observed values and mask after each revelation&lt;br&gt;Same fitted predictor within each study; probabilities&lt;br&gt;can differ across acquired subsets" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#465469;strokeWidth=1.3;fillColor=#F6F7F9;fontColor=#111111;fontFamily=Times New Roman;fontSize=18;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="350" width="585" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="M" value="&lt;b&gt;Measurement service&lt;/b&gt;&lt;br&gt;&lt;br&gt;Complete snapshot stays here&lt;br&gt;Reveal only requested values&lt;br&gt;No held-out labels to selectors&lt;br&gt;No physical process control" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#465469;strokeWidth=1.3;fillColor=#F6F7F9;fontColor=#111111;fontFamily=Times New Roman;fontSize=18;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="715" y="350" width="335" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="D" value="&lt;b&gt;D   Evaluator, record audit and statistical summaries&lt;/b&gt;&lt;br&gt;&lt;br&gt;Held-out labels are used here for scoring only&lt;br&gt;Audit identities, requests, observed values, predictions and records&lt;br&gt;Paired balanced accuracy · family/seed uncertainty · recorded runtime and memory" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#465469;strokeWidth=1.3;fillColor=#F6F7F9;fontColor=#111111;fontFamily=Times New Roman;fontSize=18;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="600" width="1020" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="AB" value="" source="A" target="B" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#465469;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=17;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="BC" value="" source="B" target="C" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#465469;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=17;labelBackgroundColor=#ffffff;exitX=0.28;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="CM" value="ID" source="C" target="M" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#465469;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=17;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="MC" value="value" source="M" target="C" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#465469;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=17;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=1;entryY=0.75;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="CD" value="episode record" source="C" target="D" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#465469;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=17;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.28;entryY=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="MD" value="held-out label" source="M" target="D" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#465469;strokeWidth=1.3;fontFamily=Times New Roman;fontSize=17;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.84;entryY=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Algorithm 1" id="Algorithm-1">
    <mxGraphModel dx="1200" dy="900" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="970" pageHeight="800" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="alg" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b&gt;Algorithm 1. Budget-constrained sensor acquisition&lt;/b&gt;&lt;br&gt;Input:&amp;nbsp;V&amp;nbsp;=&amp;nbsp;{1,&amp;nbsp;…,&amp;nbsp;41};&amp;nbsp;B;&amp;nbsp;predictor&amp;nbsp;q;&amp;nbsp;selector&amp;nbsp;pi;&amp;nbsp;flag&amp;nbsp;u;&amp;nbsp;seed&amp;nbsp;k&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;fallback&amp;nbsp;ranking&amp;nbsp;rho;&amp;nbsp;legal-ID&amp;nbsp;grammar&amp;nbsp;G;&amp;nbsp;dictionary&amp;nbsp;d;&amp;nbsp;Reveal&lt;br&gt;Output:&amp;nbsp;ordered&amp;nbsp;path&amp;nbsp;P,&amp;nbsp;prediction&amp;nbsp;ŷ,&amp;nbsp;probabilities&amp;nbsp;p,&amp;nbsp;episode&amp;nbsp;log&amp;nbsp;J&lt;br&gt;1:&amp;nbsp;&amp;nbsp;O&amp;nbsp;←&amp;nbsp;∅;&amp;nbsp;S&amp;nbsp;←&amp;nbsp;∅;&amp;nbsp;P&amp;nbsp;←&amp;nbsp;[];&amp;nbsp;J&amp;nbsp;←&amp;nbsp;[];&amp;nbsp;StartTimer()&lt;br&gt;2:&amp;nbsp;&amp;nbsp;for&amp;nbsp;t&amp;nbsp;←&amp;nbsp;0&amp;nbsp;to&amp;nbsp;B&amp;nbsp;−&amp;nbsp;1&amp;nbsp;do&lt;br&gt;3:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;L&amp;nbsp;←&amp;nbsp;V&amp;nbsp;\&amp;nbsp;S;&amp;nbsp;p&amp;nbsp;←&amp;nbsp;Round(q(O,&amp;nbsp;S),&amp;nbsp;5)&lt;br&gt;4:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;s&amp;nbsp;←&amp;nbsp;Round(EntropyScores(O,&amp;nbsp;L),&amp;nbsp;5)&amp;nbsp;if&amp;nbsp;u&amp;nbsp;else&amp;nbsp;∅&lt;br&gt;5:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;h&amp;nbsp;←&amp;nbsp;State(O,&amp;nbsp;L,&amp;nbsp;B&amp;nbsp;−&amp;nbsp;t,&amp;nbsp;p,&amp;nbsp;s);&amp;nbsp;m&amp;nbsp;←&amp;nbsp;Messages(h,&amp;nbsp;d)&lt;br&gt;6:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;a&amp;nbsp;←&amp;nbsp;⊥&lt;br&gt;7:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;for&amp;nbsp;r&amp;nbsp;←&amp;nbsp;0&amp;nbsp;to&amp;nbsp;1&amp;nbsp;do&lt;br&gt;8:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;z&amp;nbsp;←&amp;nbsp;Call(pi,&amp;nbsp;m,&amp;nbsp;G(L),&amp;nbsp;k&amp;nbsp;+&amp;nbsp;101t&amp;nbsp;+&amp;nbsp;1009r,&amp;nbsp;32,&amp;nbsp;90&amp;nbsp;s)&lt;br&gt;9:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;a&amp;nbsp;←&amp;nbsp;ParseLegal(z,&amp;nbsp;L);&amp;nbsp;Append(J,&amp;nbsp;z)&lt;br&gt;10:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;a&amp;nbsp;≠&amp;nbsp;⊥&amp;nbsp;then&amp;nbsp;break&lt;br&gt;11:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;ProcessError(z)&amp;nbsp;then&amp;nbsp;Restart(pi)&lt;br&gt;12:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;m&amp;nbsp;←&amp;nbsp;ReplyRepair(m,&amp;nbsp;z)&lt;br&gt;13:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;end&amp;nbsp;for&lt;br&gt;14:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;a&amp;nbsp;=&amp;nbsp;⊥&amp;nbsp;then&amp;nbsp;a&amp;nbsp;←&amp;nbsp;FirstLegal(rho,&amp;nbsp;L);&amp;nbsp;LogFallback(J)&lt;br&gt;15:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;v&amp;nbsp;←&amp;nbsp;Reveal(a);&amp;nbsp;O[a]&amp;nbsp;←&amp;nbsp;v;&amp;nbsp;S&amp;nbsp;←&amp;nbsp;S&amp;nbsp;∪&amp;nbsp;{a};&amp;nbsp;Append(P,&amp;nbsp;a)&lt;br&gt;16:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;LogStep(J,&amp;nbsp;h,&amp;nbsp;a,&amp;nbsp;v)&lt;br&gt;17:&amp;nbsp;end&amp;nbsp;for&lt;br&gt;18:&amp;nbsp;p&amp;nbsp;←&amp;nbsp;q(O,&amp;nbsp;S);&amp;nbsp;ŷ&amp;nbsp;←&amp;nbsp;argmax_c&amp;nbsp;p_c&lt;br&gt;19:&amp;nbsp;return&amp;nbsp;P,&amp;nbsp;ŷ,&amp;nbsp;p,&amp;nbsp;FinaliseLog(J)&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#465469;strokeWidth=1.3;fillColor=#F6F7F9;fontColor=#111111;fontFamily=Times New Roman;fontSize=18;spacing=12;align=left;verticalAlign=top;fontSize=17;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="25" y="25" width="920" height="730" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Formulas" id="Formulas">
    <mxGraphModel dx="1200" dy="900" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1250" pageHeight="1550" math="1" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="formula1" value="&lt;div style=&quot;text-align:center;font-size:18px;padding-top:8px;padding-bottom:14px&quot;&gt;&lt;b&gt;Acquisition sequence&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px&quot;&gt;$$S_0=\emptyset,\qquad a_t=\pi(h_t),\qquad S_t=S_{t-1}\cup\{a_t\},\qquad t=1,\ldots,B,$$&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#465469;strokeWidth=1.3;fillColor=#F6F7F9;fontColor=#111111;fontFamily=Times New Roman;fontSize=18;spacing=20;math=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="25" y="25" width="1200" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="formula2" value="&lt;div style=&quot;text-align:center;font-size:18px;padding-top:8px;padding-bottom:14px&quot;&gt;&lt;b&gt;Balanced accuracy&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px&quot;&gt;$$\mathrm{BA}(\pi,q,B)=\frac{1}{21}\sum_{c=0}^{20}\mathrm{recall}_c(\pi,q,B),$$&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#465469;strokeWidth=1.3;fillColor=#F6F7F9;fontColor=#111111;fontFamily=Times New Roman;fontSize=18;spacing=20;math=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="25" y="200" width="1200" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="formula3" value="&lt;div style=&quot;text-align:center;font-size:18px;padding-top:8px;padding-bottom:14px&quot;&gt;&lt;b&gt;Policy contrast&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px&quot;&gt;$$\Delta(B;\pi,\pi_0,q)=\mathrm{BA}(\pi,q,B)-\mathrm{BA}(\pi_0,q,B).$$&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#465469;strokeWidth=1.3;fillColor=#F6F7F9;fontColor=#111111;fontFamily=Times New Roman;fontSize=18;spacing=20;math=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="25" y="375" width="1200" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="formula4" value="&lt;div style=&quot;text-align:center;font-size:18px;padding-top:8px;padding-bottom:14px&quot;&gt;&lt;b&gt;Entropy score&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px&quot;&gt;$$s(j\mid S)=H\big(q(\cdot\mid x_S,S)\big)-\frac{1}{8}\sum_{d\in D(S)}H\big(q(\cdot\mid (x_S,d_j),\,S\cup\{j\})\big),$$&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#465469;strokeWidth=1.3;fillColor=#F6F7F9;fontColor=#111111;fontFamily=Times New Roman;fontSize=18;spacing=20;math=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="25" y="550" width="1200" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="formula5" value="&lt;div style=&quot;text-align:center;font-size:18px;padding-top:8px;padding-bottom:14px&quot;&gt;&lt;b&gt;Family and overall scores&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px&quot;&gt;$$\mathrm{score}_\pi(r)=\frac{1}{21K}\sum_{c=0}^{20}\sum_{k=1}^{K}\mathbf{1}\{\hat{y}(r,c,k)=y(r,c)\},\qquad&#10;\mathrm{BA}=\frac{1}{R}\sum_{r=1}^{R}\mathrm{score}_\pi(r),$$&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#465469;strokeWidth=1.3;fillColor=#F6F7F9;fontColor=#111111;fontFamily=Times New Roman;fontSize=18;spacing=20;math=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="25" y="725" width="1200" height="205" as="geometry"/>
        </mxCell>
        <mxCell id="formula6" value="&lt;div style=&quot;text-align:center;font-size:18px;padding-top:8px;padding-bottom:14px&quot;&gt;&lt;b&gt;Paired family contrast&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px&quot;&gt;$$d=\frac{1}{R}\sum_{r=1}^{R}\big(\mathrm{score}_\pi(r)-\mathrm{score}_{\pi_0}(r)\big).$$&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#465469;strokeWidth=1.3;fillColor=#F6F7F9;fontColor=#111111;fontFamily=Times New Roman;fontSize=18;spacing=20;math=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="25" y="945" width="1200" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="formula7" value="&lt;div style=&quot;text-align:center;font-size:18px;padding-top:8px;padding-bottom:14px&quot;&gt;&lt;b&gt;Log loss&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px&quot;&gt;$$\mathrm{LL}=-\frac{1}{N}\sum_{n=1}^{N}\log\max\big(q_{y_n}(x_n),\,10^{-12}\big),$$&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#465469;strokeWidth=1.3;fillColor=#F6F7F9;fontColor=#111111;fontFamily=Times New Roman;fontSize=18;spacing=20;math=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="25" y="1120" width="1200" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="formula8" value="&lt;div style=&quot;text-align:center;font-size:18px;padding-top:8px;padding-bottom:14px&quot;&gt;&lt;b&gt;Brier score&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px&quot;&gt;$$\mathrm{BS}=\frac{1}{N}\sum_{n=1}^{N}\sum_{c=0}^{20}\big(q_c(x_n)-\mathbf{1}\{y_n=c\}\big)^2,$$&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#465469;strokeWidth=1.3;fillColor=#F6F7F9;fontColor=#111111;fontFamily=Times New Roman;fontSize=18;spacing=20;math=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="25" y="1295" width="1200" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="formula9" value="&lt;div style=&quot;text-align:center;font-size:18px;padding-top:8px;padding-bottom:14px&quot;&gt;&lt;b&gt;Expected calibration error&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:23px&quot;&gt;$$\mathrm{ECE}=\sum_{b=1}^{10}\frac{n_b}{N}\,\big|\mathrm{acc}(b)-\mathrm{conf}(b)\big|,$$&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#465469;strokeWidth=1.3;fillColor=#F6F7F9;fontColor=#111111;fontFamily=Times New Roman;fontSize=18;spacing=20;math=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="25" y="1470" width="1200" height="160" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
